<Window x:Class="WpfApp1.PainelAdministrador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel do Administrador"
        Height="700"
        Width="1000"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="CONTROLE DE COMPUTADORES"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource CorTextoPrimario}"/>
                <TextBlock Text="OAB Osasco — Painel do Administrador"
                           FontSize="14"
                           Foreground="{StaticResource CorTextoSecundario}"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusConexaoText"
                           Text="Conectando..."
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CorAviso}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="BotaoHistorico"
                    Content="📊 HISTÓRICO"
                    Width="150"
                    Height="40"
                    VerticalAlignment="Center"
                    Style="{StaticResource EstiloBotaoSecundario}"
                    Click="BotaoHistorico_Click"/>

        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <WrapPanel x:Name="ListaComputadores"
                       Orientation="Horizontal"/>

        </ScrollViewer>

    </Grid>

</Window>